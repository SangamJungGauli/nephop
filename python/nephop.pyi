from typing import Callable, Optional, Union, final

# `Kshetra` has methods called `float` and `int`, which hide the builtins
# inside the class body, so annotations there use these aliases.
_Float = float
_Int = int

Value = Union[float, int, str]
Params = dict[str, Value]
Sampler = Union[RandomSampler, GridSampler]

@final
class Kshetra:
    """The search space: every parameter to tune and its allowed range."""

    def __new__(cls) -> Kshetra: ...
    def float(self, name: str, low: _Float, high: _Float) -> Kshetra: ...
    def log_float(self, name: str, low: _Float, high: _Float) -> Kshetra: ...
    def int(self, name: str, low: _Int, high: _Int) -> Kshetra: ...
    def choice(self, name: str, choices: list[str]) -> Kshetra: ...
    def grid_size(self, points: _Int) -> _Int: ...

@final
class RandomSampler:
    def __new__(cls, seed: int = 0) -> RandomSampler: ...

@final
class GridSampler:
    def __new__(cls, points: int) -> GridSampler: ...

@final
class Yatra:
    """One complete search, with every Paila (trial) in order."""

    def __new__(cls, disha: str = "minimize") -> Yatra: ...
    def ask(self, kshetra: Kshetra, sampler: Sampler) -> Params: ...
    def tell(self, params: Params, y: float) -> None: ...
    def sodha(self, kshetra: Kshetra, sampler: Sampler) -> Params: ...
    def bhana(self, params: Params, y: float) -> None: ...
    def lakshya(self) -> Optional[tuple[Params, float]]: ...
    def history(self) -> list[tuple[Params, float]]: ...
    def __len__(self) -> int: ...
    def save(self, path: str) -> None: ...
    @staticmethod
    def load(path: str) -> Yatra: ...

def random_search(
    kshetra: Kshetra,
    objective: Callable[[Params], float],
    n_paila: int,
    seed: int = 0,
    disha: str = "minimize",
) -> Yatra: ...
def grid_search(
    kshetra: Kshetra,
    objective: Callable[[Params], float],
    points: int,
    disha: str = "minimize",
) -> Yatra: ...
